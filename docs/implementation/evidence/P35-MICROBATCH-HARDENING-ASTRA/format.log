106 +
107 + def receipt_history_digest(value: Any) -> str:
108 +     """Hash bounded receipt history with the existing canonical JSON bytes.
109 +
110 +     Artifact metadata's 100,000-node / 8 MiB limits are too small for planned
111 +     LR/payload histories. Callers bound the row count; streaming serialization
112 +     enforces the science-state 128 MiB ceiling without a second full JSON copy.
113 +     This does not relax the artifact manifest limits or change digest semantics.
114 +     """
115 +     digest = hashlib.sha256()
116 +     size = 0
117 +     encoder = json.JSONEncoder(sort_keys=True, separators=(",", ":"), allow_nan=False)
118 +     for chunk in encoder.iterencode(value):
119 +         raw = chunk.encode("utf-8")
120 +         size += len(raw)
121 +         if size > 128 * 1024**2:
122 +             raise PayloadReceiptError("receipt history exceeds the 128 MiB science-state bound")
123 +         digest.update(raw)
124 +     return digest.hexdigest()
