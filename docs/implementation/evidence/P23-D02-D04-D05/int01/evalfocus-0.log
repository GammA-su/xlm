manifest = EvaluationInputManifest(manifest_version='1', scope_label='authored fixture two-task subset v1', scope_kind='authored_...dence.',), source_path=WindowsPath('D:/Project/xlm-integration/fixtures/eval/inputs/dev_fixture_subset/manifest.yaml'))
base_dir = None, tier = <SuiteTier.SEARCH: 'search'>, harness_version = None
